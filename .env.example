# Environment Configuration
PROJECT_NAME="AI-Powered Learning-to-Career Intelligence System"
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=super-secret-jwt-key-replace-in-production-min-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL default, falls back to aiosqlite for tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_intelligence
TEST_DATABASE_URL=sqlite+aiosqlite:///./test_career_intel.db

# LLM & AI Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
USE_LLM_EXTRACTION=false
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports_generated
MAX_UPLOAD_SIZE_MB=10

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
